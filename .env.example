# Copy to .env and fill in LLM_API_KEY. Never commit .env.

# LLM provider (any OpenAI-compatible endpoint; Groq by default)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# low keeps token use (and free-tier rate limits) down; set to "none" for providers without this option
LLM_REASONING_EFFORT=low

# Classification: number of samples for self-consistency (1 = single call)
CLASSIFY_SAMPLES=3
SAMPLE_TEMPERATURE=0.7

# Escalation rules
CONFIDENCE_THRESHOLD=0.70
BILLING_ESCALATION_USD=500

# Optional: a https://webhook.site/... URL that receives every routed record
WEBHOOK_URL=

OUTPUT_DIR=output
ADDR=:8080
